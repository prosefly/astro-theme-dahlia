---
import { Icon } from '@prosefly/astro-components';
import { PageSection } from '@prosefly/astro-theme-dahlia/layouts';
---

<PageSection class="home-final-cta overflow-hidden" padding="none" size="xl">
  <div class="relative grid min-h-[30rem] items-center lg:grid-cols-2">
    <div class="relative z-10 px-5 py-20 sm:px-6 sm:py-24 lg:px-16 lg:py-28">
      <p class="font-mono text-xs font-medium uppercase tracking-[0.24em] text-(--dahlia-accent)">
        Begin with Dahlia
      </p>
      <h2 class="home-final-cta__title mt-5 max-w-xl text-(--dahlia-text-strong)">
        Ready to create calmer docs?
      </h2>
      <p class="mt-5 max-w-lg text-base leading-8 text-(--dahlia-text-muted)">
        Start your documentation journey with Dahlia and bring clarity to every page.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="home-button home-button--primary" href="/docs/overview/">
          Read the docs <Icon name="lucide:arrow-right" />
        </a>
        <a class="home-button home-button--secondary" href="https://github.com/prosefly/astro-theme-dahlia" rel="noreferrer" target="_blank">
          View on GitHub <Icon name="simple-icons:github" />
        </a>
      </div>
    </div>

  </div>
</PageSection>

<style>
  .home-final-cta {
    background: color-mix(in oklab, var(--dahlia-accent-soft) 42%, var(--dahlia-background));
    border-top: 1px solid var(--dahlia-border-subtle);
    isolation: isolate;
    position: relative;
  }

  .home-final-cta::before {
    background-image: url('/images/dahlia-home-flower.png');
    background-position: right center;
    background-repeat: no-repeat;
    background-size: min(62%, 52rem) auto;
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  :global([data-theme="dark"]) .home-final-cta::before {
    background-image: url('/images/dahlia-home-flower-dark.png');
  }

  @media (prefers-color-scheme: dark) {
    :global([data-theme="system"]) .home-final-cta::before {
      background-image: url('/images/dahlia-home-flower-dark.png');
    }
  }

  .home-final-cta__title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .home-button {
    align-items: center;
    border-radius: var(--dahlia-radius-md);
    display: inline-flex;
    font-size: 0.875rem;
    font-weight: 600;
    gap: 0.5rem;
    height: 2.75rem;
    justify-content: center;
    padding-inline: 1.125rem;
    transition: border-color 160ms ease, opacity 160ms ease, transform 160ms ease;
  }

  .home-button:hover {
    transform: translateY(-1px);
  }

  .home-button:focus-visible {
    outline: 2px solid var(--dahlia-accent);
    outline-offset: 3px;
  }

  .home-button--primary {
    background: var(--dahlia-accent);
    color: var(--dahlia-accent-contrast);
  }

  .home-button--primary:hover {
    opacity: 0.9;
  }

  .home-button--secondary {
    border: 1px solid var(--dahlia-border-muted);
    color: var(--dahlia-text-strong);
  }

  .home-button--secondary:hover {
    border-color: var(--dahlia-accent);
  }

  .home-button :global(.pf-icon) {
    height: 1rem;
    width: 1rem;
  }

  @media (max-width: 1023px) {
    .home-final-cta::before {
      background-position: right bottom;
      background-size: 78% auto;
    }
  }

  @media (max-width: 639px) {
    .home-final-cta::before {
      background-position: right bottom;
      background-size: 100% auto;
    }
  }
</style>
