{
  "$schema": "https://prosefly.dev/schema/dahlia.json",
  "name": "Dahlia",
  "description": "A documentation theme for Astro.",
  "favicon": "/favicon.svg",
  "logo": "/images/dahlia-mark.svg",
  "docsBase": "/docs",
  "siteNav": [
    {
      "label": "Docs",
      "href": "/docs/"
    },
    {
      "label": "Pricing",
      "href": "/pricing/"
    },
    {
      "label": "Sponsors",
      "href": "/sponsors/"
    },
    {
      "label": "Source",
      "href": "https://github.com/prosefly/astro-theme-dahlia",
      "variant": "solid",
      "trailingIcon": "lucide:chevron-right"
    }
  ],
  "socials": [
    {
      "label": "GitHub",
      "href": "https://github.com/prosefly/astro-theme-dahlia",
      "external": true,
      "icon": "github"
    },
    {
      "label": "X",
      "href": "https://x.com/prosefly",
      "external": true,
      "icon": "x"
    }
  ],
  "contributors": {
    "max": 6,
    "exclude": ["github-actions[bot]"]
  },
  "source": {
    "github": "prosefly/astro-theme-dahlia",
    "branch": "main"
  },
  "editLink": true,
  "locales": {
    "root": {
      "label": "English",
      "lang": "en",
      "directory": "en"
    },
    "zh-cn": {
      "label": "简体中文",
      "lang": "zh-CN",
      "directory": "zh-cn"
    }
  },
  "docsNav": [
    {
      "slug": "guides",
      "label": "Guides",
      "translations": {
        "zh-cn": "指南"
      },
      "icon": "lucide:rocket",
      "items": [
        {
          "label": "Getting Started",
          "translations": {
            "zh-cn": "入门"
          },
          "items": [
            "overview",
            "installation",
            "essentials/project-structure"
          ]
        },
        {
          "label": "Write Content",
          "translations": {
            "zh-cn": "编写内容"
          },
          "items": [
            "essentials/frontmatter",
            "essentials/markdown-syntax",
            "essentials/admonitions",
            "essentials/images",
            "essentials/code-blocks"
          ]
        },
        {
          "label": "Configure",
          "translations": {
            "zh-cn": "配置"
          },
          "items": [
            "configuration/project",
            "configuration/content-routing",
            "configuration/i18n",
            "configuration/appearance",
            "configuration/navbar",
            "configuration/docs-nav",
            "configuration/footer",
            "configuration/page-actions",
            "configuration/search",
            "configuration/source",
            "configuration/assistant",
            "configuration/integrations"
          ]
        },
        {
          "label": "Customize",
          "translations": {
            "zh-cn": "自定义"
          },
          "items": [
            "customization/css-styling",
            "customization/theme-components",
            "customization/overriding-components",
            "customization/page-layouts"
          ]
        },
        {
          "label": "Ship and Maintain",
          "translations": {
            "zh-cn": "发布与维护"
          },
          "items": [
            "deployment",
            "troubleshooting",
            "changelog"
          ]
        }
      ]
    },
    {
      "slug": "components",
      "label": "Components",
      "translations": {
        "zh-cn": "组件"
      },
      "icon": "lucide:blocks",
      "items": [
        "components/icon",
        "components/badge",
        "components/callout",
        "components/cards",
        "components/steps",
        "components/tabs",
        "components/accordion",
        "components/file-tree",
        "components/audio-player",
        "components/embed"
      ]
    },
    {
      "slug": "references",
      "label": "References",
      "translations": {
        "zh-cn": "参考"
      },
      "icon": "lucide:book-open",
      "items": [
        "references/configuration",
        "references/theme-tokens",
        "references/expressive-code",
        "references/mermaid"
      ]
    }
  ],
  "footer": {
    "copyright": "Copyright © 2026 Prosefly.",
    "sections": [
      {
        "title": "Tools",
        "links": [
          {
            "label": "Appearance",
            "href": "/docs/configuration/appearance/"
          }
        ]
      },
      {
        "title": "Projects",
        "links": [
          {
            "label": "Astro Lotus Theme",
            "href": "https://astro-theme-lotus.prosefly.dev",
            "external": true
          },
          {
            "label": "Astro Components",
            "href": "https://astro-components.prosefly.dev",
            "external": true
          }
        ]
      },
      {
        "title": "Community",
        "links": [
          {
            "label": "GitHub",
            "href": "https://github.com/prosefly/astro-theme-dahlia",
            "external": true
          },
          {
            "label": "X (Twitter)",
            "href": "https://x.com/prosefly",
            "external": true
          },
          {
            "label": "Sponsors",
            "href": "/sponsors/"
          },
          {
            "label": "Sponsor Prosefly",
            "href": "https://github.com/sponsors/prosefly",
            "external": true
          }
        ]
      }
    ]
  }
}
