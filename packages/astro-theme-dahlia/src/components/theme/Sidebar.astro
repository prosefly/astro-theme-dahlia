---
import type { DocsSidebarNav } from '../../lib/docs';
import SidebarItem from '../ui/SidebarItem.astro';

interface Props {
  sidebar: DocsSidebarNav;
  currentPath?: string;
  label?: string;
  maxHeight?: string;
}

const {
  sidebar,
  currentPath,
  label,
  maxHeight = 'calc(100vh - var(--dahlia-docs-chrome-height))',
} = Astro.props;
const t = Astro.locals.t;
const ariaLabel = label ?? t('sidebar.accessibleLabel');
---

<div
  class="dahlia-sidebar-scroll relative h-full min-h-0 flex-1 max-h-(--dahlia-sidebar-max-height) overflow-hidden"
  data-dahlia-sidebar-scroll
  style={`--dahlia-sidebar-max-height: ${maxHeight}`}
>
  <div class="dahlia-sidebar-fade dahlia-sidebar-fade-top" data-dahlia-sidebar-fade-top></div>
  <nav aria-label={ariaLabel} class="dahlia-scrollbar h-full max-h-[inherit] space-y-7 overflow-y-auto pt-6 pb-2 pe-2" data-dahlia-sidebar-scroll-area>
    {sidebar.links.length > 0 && (
      <div class="space-y-1">
        {sidebar.links.map((item) => (
          <SidebarItem item={item} currentPath={currentPath} />
        ))}
      </div>
    )}

    {sidebar.groups.map((group) => (
      <section>
        <h2 class="dahlia-sidebar-group-title">
          {group.title}
        </h2>
        <div class="space-y-0.5 mx-2">
          {group.items.map((item) => (
            <SidebarItem item={item} currentPath={currentPath} />
          ))}
        </div>
      </section>
    ))}
  </nav>
  <div class="dahlia-sidebar-fade dahlia-sidebar-fade-bottom" data-dahlia-sidebar-fade-bottom></div>
</div>

<script>
  import '../../client/sidebar';
</script>
