---
import { Icon } from '@prosefly/astro-components';
import HeaderNavbar from 'virtual:prosefly/dahlia/components/HeaderNavbar';
import HeaderSocialIcons from 'virtual:prosefly/dahlia/components/HeaderSocialIcons';
import SiteBrand from 'virtual:prosefly/dahlia/components/SiteBrand';
import type { DocsNavDisplayMode, DocsSectionNav, DocsSidebarNav } from '../../lib/docs';
import { getLocales } from '../../lib/i18n';
import { resolveIconName } from '../../lib/icons';
import Dropdown from '../ui/Dropdown.astro';
import LanguageSelect from '../theme/LanguageSelect.astro';
import SearchDialog from 'virtual:prosefly/dahlia/components/SearchDialog';
import Sidebar from './Sidebar.astro';
import ThemeModeSegmentedControl from '../theme/ThemeModeSegmentedControl.astro';
import rawThemeConfig from 'virtual:prosefly/dahlia/config';
import type { DahliaThemeConfig } from '../../lib/theme';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  currentPath?: string;
  displayMode?: DocsNavDisplayMode;
  headings?: Heading[];
  sectionTitle?: string;
  sections: DocsSectionNav[];
  sidebar: DocsSidebarNav;
  sidebars?: Record<string, DocsSidebarNav>;
  title: string;
}

const {
  currentPath,
  displayMode = 'subnav',
  headings = [],
  sectionTitle,
  sections,
  sidebar,
  sidebars = {},
  title,
} = Astro.props;
const t = Astro.locals.t;
const themeConfig = rawThemeConfig as DahliaThemeConfig;
const hasSiteNav = (themeConfig.siteNav?.length ?? 0) > 0;
const hasSocials = (themeConfig.socials?.length ?? 0) > 0;
const hasLanguageSelect = getLocales(themeConfig).length > 1;
const activeSection = sections.find((section) => section.active) ?? sections[0];
const activeSectionSlug = activeSection?.slug;
const visibleHeadings = headings;

function formatPageCountLabel(count: number): string {
  return t(count === 1 ? 'mobileDocs.pageCount.one' : 'mobileDocs.pageCount.other', { count });
}

function getHeadingIndent(depth: number): string {
  if (depth <= 2) {
    return 'ps-3';
  }

  if (depth === 3) {
    return 'ps-5';
  }

  return 'ps-7';
}
---

<div class="lg:hidden">
  <div class="dahlia-border-subtle flex h-(--dahlia-subnav-height) items-center gap-3 border-t px-2 sm:px-4">
    <button
      aria-controls="dahlia-mobile-sidebar"
      aria-expanded="false"
      aria-label={t('mobileDocs.openMenu')}
      class="dahlia-focus-ring flex h-9 min-w-0 flex-1 items-center gap-3 rounded-(--dahlia-radius-md) text-start text-(--dahlia-text-muted) transition-colors hover:bg-(--dahlia-surface) hover:text-(--dahlia-text-strong)"
      data-dahlia-mobile-sidebar-open
      type="button"
    >
      <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center">
        <Icon aria-hidden="true" class="h-5 w-5" name="lucide:menu" />
      </span>
      <span class="flex min-w-0 flex-1 items-center gap-2 text-sm leading-5">
        {sectionTitle ? (
          <>
            <span class="truncate font-medium text-(--dahlia-text-strong)">{sectionTitle}</span>
            <span aria-hidden="true" class="shrink-0 text-(--dahlia-text-muted)">›</span>
            <span class="truncate text-(--dahlia-text-muted)">{title}</span>
          </>
        ) : (
          <span class="truncate font-medium text-(--dahlia-text-strong)">{title}</span>
        )}
      </span>
    </button>

    {visibleHeadings.length > 0 && (
      <Dropdown
        class="shrink-0"
        contentClass="dahlia-border-subtle absolute end-0 top-11 z-50 max-h-[min(22rem,calc(100vh-var(--dahlia-docs-chrome-height)-1rem))] w-64 overflow-y-auto rounded-[min(var(--dahlia-radius-lg),1rem)] border bg-(--dahlia-background) p-3 shadow-xl"
        triggerClass="dahlia-focus-ring flex h-9 cursor-pointer items-center rounded-(--dahlia-radius-md) px-2.5 text-sm font-medium text-(--dahlia-text-muted) transition-colors hover:bg-(--dahlia-surface) hover:text-(--dahlia-text-strong)"
        triggerLabel={t('tableOfContents.onThisPage')}
      >
        <Fragment slot="trigger">
          {t('tableOfContents.onThisPage')}
        </Fragment>

        <nav aria-label={t('tableOfContents.onThisPage')}>
          <ul class="dahlia-border-subtle dahlia-toc-list relative space-y-0.5 border-s" data-toc-list>
            <li aria-hidden="true" class="dahlia-toc-indicator"></li>
            {visibleHeadings.map((heading) => (
              <li>
                <a
                  class:list={[
                    'dahlia-focus-ring dahlia-toc-link block py-1.5 pe-2 text-sm leading-5 transition-colors',
                    getHeadingIndent(heading.depth),
                    'text-(--dahlia-text-muted) hover:text-(--dahlia-text-strong)',
                  ]}
                  data-dahlia-dropdown-close
                  data-toc-link={heading.slug}
                  href={`#${heading.slug}`}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </Dropdown>
    )}
  </div>

  <div
    class="dahlia-mobile-sidebar fixed h-screen inset-0 z-50 lg:hidden"
    data-dahlia-mobile-sidebar
    hidden
    id="dahlia-mobile-sidebar"
    inert
  >
    <button
      aria-label={t('mobileDocs.closeMenu')}
      class="dahlia-mobile-sidebar-backdrop absolute inset-0 bg-black/30"
      data-dahlia-mobile-sidebar-close
      type="button"
    ></button>
    <aside
      aria-label={t('mobileDocs.menu')}
      aria-modal="true"
      class="dahlia-mobile-sidebar-panel relative flex h-full w-[min(23rem,calc(100vw-2rem))] flex-col bg-(--dahlia-background) shadow-2xl"
      role="dialog"
    >
      <div class="dahlia-border-subtle flex h-(--dahlia-header-height) shrink-0 items-center justify-between border-b px-4">
        <SiteBrand markIdPrefix="dahlia-mobile-brand" textClass="truncate text-sm font-semibold" />
        <div class="flex items-center gap-1">
          <button
            aria-label={t('mobileDocs.closeMenu')}
            class="dahlia-focus-ring inline-flex h-9 w-9 items-center justify-center rounded-(--dahlia-radius-md) text-(--dahlia-text-muted) transition-colors hover:bg-(--dahlia-surface) hover:text-(--dahlia-text-strong)"
            data-dahlia-mobile-sidebar-close
            type="button"
          >
            <Icon aria-hidden="true" class="h-5 w-5" name="lucide:x" />
          </button>
        </div>
      </div>

      {(hasSiteNav || hasSocials) && (
        <div class="dahlia-border-subtle shrink-0 border-b px-4 py-3">
          {hasSiteNav && <HeaderNavbar currentPath={currentPath} mobile />}
          {hasSocials && (
            <div
              class:list={[
                hasSiteNav && 'dahlia-border-subtle mt-3 border-t pt-3',
                'flex items-center gap-2',
              ]}
            >
              {hasSocials && <HeaderSocialIcons mobile />}
            </div>
          )}
        </div>
      )}

      <div class="shrink-0 px-4 pt-4">
        <SearchDialog variant="rail" />
      </div>

      {displayMode === 'subnav' && <div class="shrink-0 p-4">
        {activeSection ? (
          <details class="group/dahlia-section-switch relative" data-dahlia-section-switch>
        <summary class="dahlia-focus-ring dahlia-border-muted flex min-h-12 cursor-pointer list-none items-center gap-3 rounded-(--dahlia-radius-md) border bg-(--dahlia-surface) px-3 py-2 text-(--dahlia-text-strong) marker:hidden transition-colors hover:border-(--dahlia-accent) hover:bg-(--dahlia-accent-soft)">
              <span class="relative h-5 w-5 shrink-0">
                {sections.map((section) => (
                  section.icon && (
                    <span
                      class="absolute inset-0"
                      data-dahlia-section-summary-icon={section.slug}
                      hidden={section.slug !== activeSectionSlug}
                    >
                      <Icon
                        aria-hidden="true"
                        class="h-5 w-5 text-(--dahlia-accent)"
                        name={resolveIconName(section.icon)}
                      />
                    </span>
                  )
                ))}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-base font-semibold" data-dahlia-section-summary-label>
                  {activeSection.label}
                </span>
                <span class="block truncate text-xs text-(--dahlia-text-muted)" data-dahlia-section-summary-count>
                  {formatPageCountLabel(activeSection.items.length)}
                </span>
              </span>
              <Icon
                aria-hidden="true"
                class="h-4 w-4 shrink-0 text-(--dahlia-text-muted)"
                name="lucide:chevrons-up-down"
              />
            </summary>
            <div class="dahlia-border-subtle absolute start-0 end-0 top-[calc(100%+0.5rem)] z-20 space-y-1 rounded-[min(var(--dahlia-radius-lg),1rem)] border bg-(--dahlia-background) p-1.5 shadow-lg">
              {sections.map((section) => (
                <button
                  aria-current={section.slug === activeSectionSlug ? 'page' : undefined}
                  class="dahlia-focus-ring dahlia-mobile-section-option flex min-h-14 w-full items-center gap-3 rounded-(--dahlia-radius-md) px-3 py-2 text-start transition-colors"
                  data-active={section.slug === activeSectionSlug ? '' : undefined}
                  data-dahlia-section-count={formatPageCountLabel(section.items.length)}
                  data-dahlia-section-label={section.label}
                  data-dahlia-section-option={section.slug}
                  type="button"
                >
                  {section.icon && (
                    <Icon
                      aria-hidden="true"
                      class="dahlia-mobile-section-icon h-5 w-5 shrink-0"
                      name={resolveIconName(section.icon)}
                    />
                  )}
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm font-semibold">{section.label}</span>
                    <span class="block truncate text-xs text-(--dahlia-text-muted)">
                      {formatPageCountLabel(section.items.length)}
                    </span>
                  </span>
                  <span class="dahlia-mobile-section-check ms-auto hidden h-4 w-4 shrink-0">
                    <Icon
                      aria-hidden="true"
                      class="h-4 w-4 text-(--dahlia-accent)"
                      name="lucide:check"
                    />
                  </span>
                </button>
              ))}
            </div>
          </details>
        ) : (
          <p class="text-sm font-medium text-(--dahlia-text-strong)">{t('mobileDocs.documentation')}</p>
        )}
      </div>}

      <div class="flex min-h-0 flex-1 flex-col overflow-hidden px-4 py-3">
        {displayMode === 'flat' ? (
          <Sidebar currentPath={currentPath} maxHeight="100%" sidebar={sidebar} />
        ) : (
          sections.map((section) => {
            const sectionSidebar = sidebars[section.slug] ?? (section.slug === activeSectionSlug ? sidebar : undefined);

            return sectionSidebar && (
              <div
                class="dahlia-mobile-section-panel min-h-0 flex-1"
                data-dahlia-section-panel={section.slug}
                hidden={section.slug !== activeSectionSlug}
              >
                <Sidebar currentPath={currentPath} maxHeight="100%" sidebar={sectionSidebar} />
              </div>
            );
          })
        )}
      </div>

      <div class="dahlia-border-subtle flex shrink-0 items-center justify-between gap-3 border-t px-4 py-3">
        {hasLanguageSelect && <LanguageSelect dropup />}
        <ThemeModeSegmentedControl />
      </div>

    </aside>
  </div>
</div>

<script>
  import '../../client/mobile-docs-nav';
</script>
