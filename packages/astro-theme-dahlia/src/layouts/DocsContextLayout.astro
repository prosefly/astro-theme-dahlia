---
import {
  getDocsContext,
  getDocsNavigationHandoff,
  getFlatSidebarNavigation,
  getSidebarSectionTitle,
} from '../lib/docs';
import type { DocsNavigationHandoff } from '../lib/docs';
import type { NormalizedLocale } from '../lib/i18n';
import type { HeadConfig } from '../lib/page/head';
import type { JsonLdNode } from '../lib/page/schema';
import DocsLayout from './DocsLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  head?: HeadConfig;
  jsonLd?: JsonLdNode | JsonLdNode[];
  locale?: NormalizedLocale;
  currentPath?: string;
  currentSection?: string;
  currentSlug?: string;
  headings?: Heading[];
  pagefind?: boolean;
  navigation?: DocsNavigationHandoff;
}

const props = Astro.props;
const navigation = props.navigation ?? getDocsNavigationHandoff(
  await getDocsContext(props.currentSection, props.locale?.key),
  props.currentSection,
);
const currentSection = props.currentSection ?? navigation.currentSection;
const sidebars = navigation.sidebars;
const sidebar = currentSection ? sidebars[currentSection] ?? { links: [], groups: [] } : { links: [], groups: [] };
const displaySidebar = navigation.displayMode === 'flat'
  ? getFlatSidebarNavigation(navigation.sections, sidebars)
  : sidebar;
const sectionTitle = props.currentSlug ? getSidebarSectionTitle(sidebar, props.currentSlug) : undefined;
---

<DocsLayout
  title={props.title}
  description={props.description}
  head={props.head}
  jsonLd={props.jsonLd}
  locale={props.locale ?? navigation.locale}
  currentPath={props.currentPath}
  sectionTitle={sectionTitle}
  docsNavMode={navigation.displayMode}
  headings={props.headings}
  pagefind={props.pagefind}
  subnav={navigation.sections}
  sidebar={displaySidebar}
  sidebars={sidebars}
>
  <slot />

  <Fragment slot="aside">
    <slot name="aside" />
  </Fragment>
</DocsLayout>
