---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import rawThemeConfig from 'virtual:prosefly/dahlia/config';
import type { HeadConfig } from '../lib/page/head';
import type { NormalizedLocale } from '../lib/i18n';
import { isPagefindSearchEnabled } from '../lib/search';
import type { DahliaThemeConfig } from '../lib/theme';

interface Props {
  title: string;
  description?: string;
  head?: HeadConfig;
  locale?: NormalizedLocale;
  pagefind?: boolean;
}

const { title, description, head, locale, pagefind = true } = Astro.props;
const themeConfig = rawThemeConfig as DahliaThemeConfig;
const pagefindEnabled = isPagefindSearchEnabled(themeConfig);
const pagefindAttrs = pagefindEnabled
  ? pagefind
    ? { 'data-pagefind-body': true }
    : { 'data-pagefind-ignore': true }
  : {};
---

<BaseLayout title={title} description={description} head={head} locale={locale}>
  <SiteHeader showLanguage={false} surface />

  <main class="mx-auto max-w-screen-2xl px-5 py-12 sm:px-6 sm:py-16">
    <article class="mx-auto max-w-3xl" {...pagefindAttrs}>
      <header class="mb-8 border-b border-(--dahlia-border-subtle) pb-8">
        <h1 class="text-4xl font-semibold leading-tight tracking-normal text-(--dahlia-text-strong)">
          {title}
        </h1>
        {description && (
          <p class="mt-4 text-base leading-7 text-(--dahlia-text-muted)">
            {description}
          </p>
        )}
      </header>

      <div class="dahlia-prose">
        <slot />
      </div>
    </article>
  </main>

  <Footer showLanguage />
</BaseLayout>
